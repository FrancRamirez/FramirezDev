# Copiar este archivo a .env.local y llenar los valores

# Resend API Key (obtén tu key en https://resend.com)
RESEND_API_KEY=tu_resend_api_key_aqui

# TiDB Cloud (pantalla "Connect" del cluster -> pestaña "Parameters")
DB_HOST=tu_host.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=tu_usuario.root
DB_PASSWORD=tu_password
DATABASE=tu_database

# Secreto para firmar el JWT de sesión (cualquier string largo y random)
SESSION_SECRET=cambiar_por_un_secreto_largo_y_random

# Mercado Pago (Developers -> Tus integraciones -> Credenciales de producción/prueba)
# MP_ACCESS_TOKEN es secreto: nunca lo compartas ni lo subas al repo.
# MP_PUBLIC_KEY se expone al frontend, no es secreta.
MP_ACCESS_TOKEN=tu_access_token_aqui
MP_PUBLIC_KEY=tu_public_key_aqui
# Clave secreta que te da MP al guardar la URL en Webhooks > Configurar notificaciones
MP_WEBHOOK_SECRET=tu_clave_secreta_del_webhook_aqui

# Producto en venta (podés cambiar esto sin tocar código)
MP_APP_ID=app-nueva
MP_APP_TITULO=Nombre de la app
MP_APP_PRECIO=5000
